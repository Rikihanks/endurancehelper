{
  "name": "endurance-helper",
  "version": "0.2.0",
  "private": true,
  "description": "Endurance kart racing helper - monorepo (backend/ Node.js + frontend/ React)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:back": "npm run dev --workspace backend",
    "dev:front": "npm run dev --workspace frontend",
    "dev": "npm run dev:back & npm run dev:front",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "test": "npm test --workspace backend",
    "setup": "npm install"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
