# Producción — copia a .env.production y rellena.
NODE_ENV=production
PORT=8080
APP_URL=https://tu.dominio.com
DATABASE_URL=postgres://endurance:CAMBIAME@postgres:5432/endurance_prod

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Build-time (se inyecta al hacer docker build --build-arg / via compose)
VITE_GOOGLE_CLIENT_ID=

JWT_SECRET=CAMBIAME-genera-uno-fuerte
COOKIE_SAME_SITE=lax

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# CORS (separar por comas si hace falta)
CORS_ORIGINS=https://tu.dominio.com

LOG_LEVEL=info

# Docker compose extras
POSTGRES_USER=endurance
POSTGRES_PASSWORD=CAMBIAME
POSTGRES_DB=endurance_prod
APP_PORT=8080
