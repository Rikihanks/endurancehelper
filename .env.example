# ---- Server ----
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080

# ---- Database ----
# Development / local via docker-compose.dev.yml
DATABASE_URL=postgres://endurance:endurance@localhost:5432/endurance_dev

# ---- Google OAuth (Fase 2) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Frontend build-time Google client id (same value as GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# ---- Session JWT (Fase 2) ----
# Also used to sign the short-lived (24h) InLap Box (ESP32) WebSocket tokens
# (POST /api/esp32/register + Authorization: Bearer on /ws).
JWT_SECRET=change-me-in-production

# Session cookie SameSite. Leave unset (Lax) when frontend + API share origin.
# Set to "none" ONLY when the frontend is on a different origin (e.g. Netlify)
# and you serve over HTTPS (requires NODE_ENV=production).
COOKIE_SAME_SITE=lax

# ---- Stripe (Fase 4) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# ---- CORS whitelist (comma separated, Fase 7) ----
CORS_ORIGINS=http://localhost:5173

# ---- Logging (Fase 7) ----
LOG_LEVEL=info
