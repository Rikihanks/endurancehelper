# Staging / test — copia a .env.staging y rellena.
# Corre en paralelo a prod (puerto 8081 por defecto, su propia BD).
NODE_ENV=staging
PORT=8080
APP_URL=https://test.tu.dominio.com
DATABASE_URL=postgres://endurance:CAMBIAME@postgres:5432/endurance_staging

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

JWT_SECRET=CAMBIAME-genera-uno-fuerte
COOKIE_SAME_SITE=lax

# Stripe (opcional en staging)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

CORS_ORIGINS=https://test.tu.dominio.com

LOG_LEVEL=debug

# Docker compose extras
POSTGRES_USER=endurance
POSTGRES_PASSWORD=CAMBIAME
POSTGRES_DB=endurance_staging
APP_PORT=8081
