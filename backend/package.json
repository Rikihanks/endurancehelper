{
  "name": "endurance-helper-backend",
  "version": "0.2.0",
  "description": "Endurance kart racing helper - backend (all business logic, strategy, Apex live timing)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.js",
    "db:reset": "node scripts/reset-db.mjs",
    "promote:admin": "node scripts/promote-admin.mjs",
    "migrate:legacy": "node scripts/migrate-legacy-data.mjs",
    "seed:license": "node scripts/seed-license.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.1",
    "pg": "^8.23.0",
    "stripe": "^22.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "pg-mem": "^3.0.14"
  }
}
